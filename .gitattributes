# Normalise to LF in the repo and in the working tree. Without this,
# core.autocrlf=true warns on every LF file Git touches on Windows.
* text=auto eol=lf

# Binary assets — never touch their bytes
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
