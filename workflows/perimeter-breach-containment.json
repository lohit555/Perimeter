    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item && item.body ? item.body : (item || {});\nconst required = ['vendorName', 'domain', 'severity', 'userId'];\nconst missing = [];\nfor (const f of required) { if (!body[f]) missing.push(f); }\nconst severity = (body.severity || '').toString().toLowerCase();\nconst isHighOrCritical = severity === 'high' || severity === 'critical';\nconst fieldsValid = missing.length === 0;\nlet validationMessage;\nif (!fieldsValid) { validationMessage = 'Missing required field(s): ' + missing.join(', '); }\nelse if (!isHighOrCritical) { validationMessage = \"Severity '\" + body.severity + \"' is below the containment threshold (requires high or critical)\"; }\nelse { validationMessage = 'Event validated for containment'; }\nreturn [{ json: {\n  vendorName: body.vendorName || null,\n  domain: body.domain || null,\n  severity: body.severity || null,\n  userId: body.userId || null,\n  incidentId: body.incidentId || null,\n  detectedAt: body.detectedAt || null,\n  fieldsValid: fieldsValid,\n  missingFields: missing,\n  isHighOrCritical: isHighOrCritical,\n  validationMessage: validationMessage,\n  logStep: '1. Breach event received and validated'\n} }];"
      },
      "id": "7b36e3ae-fdfc-4005-a643-0954f05ac678",
      "name": "Validate Breach Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
