    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst tokens = [];\nfor (const it of items) {\n  const j = it.json || {};\n  if (Object.keys(j).length === 0) continue;\n  if (Array.isArray(j)) { for (const t of j) tokens.push(t); continue; }\n  if (Array.isArray(j.tokens)) { for (const t of j.tokens) tokens.push(t); continue; }\n  if (Array.isArray(j.data)) { for (const t of j.data) tokens.push(t); continue; }\n  if (Array.isArray(j.items)) { for (const t of j.items) tokens.push(t); continue; }\n  if (j.id || j.tokenId || j.token_id) tokens.push(j);\n}\nconst v = $('Validate Breach Event').first().json;\nreturn [{ json: {\n  tokens: tokens,\n  tokenCount: tokens.length,\n  vendorName: v.vendorName,\n  domain: v.domain,\n  severity: v.severity,\n  userId: v.userId,\n  incidentId: v.incidentId,\n  detectedAt: v.detectedAt,\n  logStep: '2. Vendor matched against active tokens (' + tokens.length + ' found)'\n} }];"
      },
      "id": "8e1e397a-9585-4047-95c8-747fdb7ebd62",
      "name": "Summarize Active Tokens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "has-tokens",
              "leftValue": "={{ $json.tokenCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "e0825ebb-3b7f-49cb-b638-a2208e8014c6",
      "name": "Any Active Tokens?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Summarize Active Tokens').first().json;\nconst out = [];\nfor (const t of s.tokens) {\n  out.push({ json: {\n    id: t.id || t.tokenId || t.token_id,\n    vendor_id: t.vendor_id != null ? t.vendor_id : (t.vendorId != null ? t.vendorId : null),\n    vendor_name: t.vendor_name || s.vendorName || null,\n    vendor_domain: t.vendor_domain || s.domain || null,\n    masked_value: t.masked_value || null,\n    monthly_limit: t.monthly_limit != null ? t.monthly_limit : null,\n    recurring: t.recurring != null ? t.recurring : false,\n    incidentId: s.incidentId,\n    detectedAt: s.detectedAt,\n    token: t\n  } });\n}\nreturn out;"
      },
